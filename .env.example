# ==============================================================================
# TIP CRM — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER-ONLY SECRETS (Strictly server-side; NEVER prefix with VITE_ or expose to client)
# ------------------------------------------------------------------------------
# Required for Gemini AI API calls on the backend.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Supabase Service Role Key (Server-only; full database bypass privileges)
SUPABASE_SERVICE_ROLE_KEY=

# Relational Database Connection String (Server-only PostgreSQL)
DATABASE_URL=

# Google OAuth Server Secret (Server-side token exchange only)
GOOGLE_CLIENT_SECRET=

# Mailchimp / Third-Party Secret API Credentials
MAILCHIMP_SECRET=

# Official CRM Sender Email Address (default: crm@theinclusionproject.ca)
CRM_SENDER_EMAIL="crm@theinclusionproject.ca"

# Transactional Email Providers & Gmail SMTP (Server-side delivery: Dedicated Gmail SMTP, Resend, or SendGrid)
# Recommended Gmail SMTP configuration:
#   SMTP_HOST="smtp.gmail.com"
#   SMTP_PORT=587
#   SMTP_USER="tipcrm090@theinclusionproject.ca"
#   SMTP_PASS="xxxx-xxxx-xxxx-xxxx" # 16-character Google App Password (requires 2-Step Verification)
#   SMTP_FROM_EMAIL="tipcrm090@theinclusionproject.ca"
#   SMTP_FROM_NAME="TIP CRM"
#   SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_SECURE=false
RESEND_API_KEY=
SENDGRID_API_KEY=

# Internal Application Host URL (Used by backend for redirects and callbacks)
APP_URL="http://localhost:3000"

# Anti-CSRF Token Cryptographic Secret (Server-only 32+ character high-entropy key)
CSRF_SECRET="change-this-to-a-secure-random-secret-in-production"

# Session Cookie Signing Secret (Server-only 32+ character high-entropy key)
SESSION_SECRET="change-this-to-a-secure-random-secret-in-production"

# ------------------------------------------------------------------------------
# 2. CLIENT-SAFE VARIABLES (Safe to prefix with VITE_ for browser usage)
# ------------------------------------------------------------------------------
# Supabase Public API URL
VITE_SUPABASE_URL=

# Supabase Public Anon Key (Protected by Supabase Row-Level Security policies)
VITE_SUPABASE_ANON_KEY=

# Google OAuth Client ID (Client-safe; configured in Google Cloud Console & Supabase)
VITE_GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# 3. GOOGLE OAUTH & SUPABASE AUTH REDIRECT CONFIGURATION
# ------------------------------------------------------------------------------
# Google Cloud Console (Credentials -> OAuth 2.0 Client IDs):
#   Authorized JavaScript Origins:
#     - http://localhost:3000
#     - http://localhost:5173
#     - https://crm.theinclusionproject.ca
#     - https://theinclusionproject.ca
#     - https://osbsacgmjkqyfkjdeten.supabase.co
#
#   Authorized Redirect URIs:
#     - https://osbsacgmjkqyfkjdeten.supabase.co/auth/v1/callback
#
# Supabase Dashboard (Authentication -> URL Configuration):
#   - Site URL: http://localhost:3000/
#   - Redirect URLs:
#       http://localhost:3000/**
#       http://localhost:5173/**
#       https://crm.theinclusionproject.ca/**
#       https://theinclusionproject.ca/**
